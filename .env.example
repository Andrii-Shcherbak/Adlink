# ---- Local development settings ----
PORT=3000
AUTH_DOMAIN=http://localhost:3000
# Public domain used in short links and QR codes (build-time; falls back to the current origin).
# Set this on Vercel so QR codes never point at localhost or a *.vercel.app preview.
# VITE_APP_URL=https://adlink.dcxtransform.com

# ---- Database (Postgres / Neon) — REQUIRED ----
# Copy DATABASE_URL from Replit Secrets (or a new Neon database).
DATABASE_URL=

# ---- Sessions — REQUIRED (generated locally) ----
SESSION_SECRET=

# ---- AI suggestions (Google Gemini) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, defaults to gemini-flash-lite-latest
# GEMINI_MODEL=

# ---- File storage for PDF + digital asset uploads ----
# gcs or azure. Defaults to gcs when GCS_BUCKET_NAME is set.
STORAGE_PROVIDER=gcs

# Google Cloud Storage
GCS_BUCKET_NAME=
# Service account key: the JSON key file contents on one line, or base64 of it.
# Locally you can instead set GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/key.json
GCS_SERVICE_ACCOUNT_KEY=

# ---- Azure Blob Storage (alternative provider) ----
# Azure Portal > Storage account > Security + networking > Access keys > Connection string
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=documents

# ---- Email (SendGrid) — optional, used for user invites ----
SENDGRID_API_KEY=
EMAIL_FROM=dev@dcxtransform.com

# ---- Microsoft login — optional ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
